{
  "version": "quality-contract-v1",
  "scope": "pinned-monthly-silver-and-gold-sample",
  "rules": [
    {"rule_id":"DQ001","severity":"error","stage":"input","target":"baseline bundle","owner":"flux.validation","scope":"all frozen artifacts","null_policy":"required","expectation":"completed baseline and matching artifact SHA-256","check":"integrity","depends_on":[]},
    {"rule_id":"DQ002","severity":"error","stage":"input","target":"source context","owner":"flux.validation","scope":"same source and policy","null_policy":"required","expectation":"user_name, UTC, 30000ms and consistent source state","check":"context","depends_on":["DQ001"]},
    {"rule_id":"DQ003","severity":"error","stage":"silver","target":"monthly keys","owner":"flux.validation","scope":"monthly input","null_policy":"keys cannot be blank","expectation":"nonblank user_name and MSID, valid YYYY-MM","check":"required","depends_on":["DQ001"]},
    {"rule_id":"DQ004","severity":"error","stage":"silver","target":"monthly grain","owner":"flux.validation","scope":"user_name+MSID+UTC month","null_policy":"required keys","expectation":"duplicate keys = 0","check":"unique","depends_on":["DQ003"]},
    {"rule_id":"DQ005","severity":"error","stage":"silver","target":"play_count","owner":"flux.validation","scope":"monthly input","null_policy":"not allowed","expectation":"positive integer; bool is not a count","check":"counts","depends_on":["DQ001"]},
    {"rule_id":"DQ006","severity":"error","stage":"silver","target":"song dimensions and credits","owner":"flux.validation","scope":"selected song scope","null_policy":"recording MBID may be null","expectation":"unique dimension keys and credits, all monthly and credit references resolved","check":"references","depends_on":["DQ003"]},
    {"rule_id":"DQ007","severity":"info","stage":"silver","target":"observed recording MBID","owner":"flux.validation","scope":"metadata variants, not listening events","null_policy":"allowed","expectation":"measure missing IDs without deleting rows","check":"missing_ids","depends_on":["DQ001"]},
    {"rule_id":"DQ008","severity":"error","stage":"silver","target":"declared valid detailed listens","owner":"flux.validation","scope":"details only; monthly table has no duration","null_policy":"missing duration allowed","expectation":"existing quality.judge passes each declared valid record","check":"valid_details","depends_on":["DQ001","DQ002"]},
    {"rule_id":"DQ009","severity":"error","stage":"silver","target":"quarantine probe","owner":"flux.validation","scope":"stored quarantined rows","null_policy":"use existing judge semantics","expectation":"rejection and stored first reason match quality.judge","check":"quarantine","depends_on":["DQ001","DQ002"]},
    {"rule_id":"DQ010","severity":"error","stage":"gold","target":"play conservation","owner":"flux.validation","scope":"each month/year mart separately","null_policy":"counts required","expectation":"song, coverage, variant, listener and identity totals equal input; artist totals excluded","check":"conservation","depends_on":["DQ003","DQ004","DQ005","DQ006"]},
    {"rule_id":"DQ011","severity":"error","stage":"gold","target":"metric ranges","owner":"flux.validation","scope":"14 sample marts","null_policy":"present metrics cannot be null","expectation":"integer counts, listeners<=listens, finite shares and concentration within defined ranges","check":"bounds","depends_on":["DQ001"]},
    {"rule_id":"DQ012","severity":"error","stage":"gold","target":"independent expectations","owner":"flux.validation","scope":"14 sample marts; not whole-Gold ranks","null_policy":"exact comparison","expectation":"all keys/columns match Python oracle; float tolerance 1e-12","check":"oracle","depends_on":["DQ002","DQ003","DQ004","DQ005","DQ006"]},
    {"rule_id":"DQ013","severity":"error","stage":"gold","target":"version partitions","owner":"flux.validation","scope":"dimension and song labels","null_policy":"unmarked is not original","expectation":"source version labels retained; mixed labels must be explicit conflicting_labels","check":"versions","depends_on":["DQ006"]},
    {"rule_id":"DQ014","severity":"error","stage":"review","target":"R9 production mapping","owner":"flux.validation","scope":"P0 reference-only snapshot","null_policy":"no new mapping allowed","expectation":"approved_candidates = 0 and mappings empty; future nonempty approvals require journal revalidation","check":"review","depends_on":["DQ001","DQ002"]},
    {"rule_id":"DQ015","severity":"warning","stage":"silver","target":"unusable playback duration","owner":"flux.validation","scope":"raw probe only","null_policy":"missing is allowed and measured","expectation":"warn on nonnumeric, bool or nonfinite duration; preserve existing judge behavior","check":"duration_profile","depends_on":["DQ001"]},
    {"rule_id":"DQ016","severity":"warning","stage":"collection","target":"dump continuity","owner":"flux.validation","scope":"local retained inventory","null_policy":"unknown is not ready","expectation":"warn on gaps, overlaps or unconfirmed future inputs; P2 readiness remains separate","check":"collection","depends_on":["DQ001"]},
    {"rule_id":"DQ017","severity":"warning","stage":"observability","target":"profile calibration","owner":"flux.validation","scope":"identical population and policy only","null_policy":"missing reference means calibration pending","expectation":"no arbitrary live thresholds; warn on missing/incomparable reference or same-scope metric change","check":"profile","depends_on":["DQ002","DQ003","DQ004","DQ005","DQ006"]}
  ]
}
