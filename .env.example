# 이 파일을 .env로 복사해 값을 채운다. .env는 커밋되지 않는다.

# 데이터 루트. 저장소 밖의 경로여야 한다.
# 로컬:   file:///D:/flux-data   또는  D:/flux-data
# 클라우드: s3a://버킷명/flux
FLUX_STORAGE_ROOT=

# 서빙 마트 PostgreSQL
SERVING_DB_USER=flux
SERVING_DB_PASSWORD=
SERVING_DB_NAME=flux_serving

# Airflow 메타 PostgreSQL
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=
AIRFLOW_DB_NAME=airflow

# Airflow 초기 관리자 계정
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_ADMIN_EMAIL=admin@example.com

# Airflow 암호화 키. 아래 명령으로 생성한다.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# 컨테이너가 로그를 쓸 때 쓰는 UID. 리눅스에서 권한 문제가 나면 `id -u` 값으로 바꾼다.
AIRFLOW_UID=50000
